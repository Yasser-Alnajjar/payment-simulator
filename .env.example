# Copy to .env (repo root) and fill in. NEVER commit .env.
# Dedicated hosted Supabase project (ref: yxyhgelnenqeulzxukrc). No local Supabase is used.

APP_ENV=development            # development | production
APP_URL=http://localhost:3100

# --- Supabase (public values are safe for the browser; they are anon/publishable only) ---
NEXT_PUBLIC_SUPABASE_URL=https://yxyhgelnenqeulzxukrc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key is intentionally NOT used by this app. Do not add it.

# --- Database (server-side only) ---
# Web runtime: transaction pooler (port 6543), serverless friendly.
DATABASE_URL=postgresql://postgres.yxyhgelnenqeulzxukrc:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Worker (S4): session pooler (port 5432 on the pooler host) or direct.
WORKER_DATABASE_URL=postgresql://postgres.yxyhgelnenqeulzxukrc:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Migrations: direct connection, or session pooler if your network has no IPv6.
DIRECT_URL=postgresql://postgres.yxyhgelnenqeulzxukrc:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- App secrets ---
# 32 random bytes, base64: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# --- Tests (optional, opt-in) ---
# Integration tests create and drop ONLY a throwaway schema named sbx_test_<random> in this database.
# Leave unset to skip them. Needs CREATE privilege on the database.
# TEST_DATABASE_URL=
