generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model ApiCredential {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// auth.users.id. The FK (ON DELETE CASCADE) is raw SQL in the migration; Prisma does not model the auth schema.
  userId           String    @map("user_id") @db.Uuid
  clientId         String    @unique @map("client_id")
  /// SHA-256 hex of the client secret. The plaintext is never stored.
  clientSecretHash String    @map("client_secret_hash")
  /// Display-only, e.g. "sbx_sk_…a1b2".
  clientSecretHint String    @map("client_secret_hint")
  /// AES-256-GCM ciphertext. The signing key is only in the app environment.
  webhookSecretEnc String    @map("webhook_secret_enc")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  /// NULL = active. A raw-SQL partial unique index guarantees at most one active row per user.
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// NULL = never expires. Enforced on every API request.
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("api_credentials")
}

/// Append-only. No foreign keys: history outlives the user and the resources it describes.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Immutable amount/currency (DB trigger). Terminal statuses are immutable (DB trigger).
model CheckoutSession {
  id              String   @id @db.Uuid
  /// Creation-order cursor for keyset pagination.
  seq             BigInt   @unique @default(autoincrement())
  userId          String   @map("user_id") @db.Uuid
  /// SHA-256 of the checkout token. The token itself is never stored in this table.
  tokenHash       String   @unique @map("token_hash")
  amountMinor     BigInt   @map("amount_minor")
  currency        String
  externalReference String? @map("external_reference")
  metadata        Json     @default("{}")
  presetScenario  String?  @map("preset_scenario")
  status          String   @default("open")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  transactions    Transaction[]

  @@unique([id, userId])
  @@unique([id, userId, amountMinor, currency])
  @@map("checkout_sessions")
}

/// Owner, amount and currency are tied to the session by a composite FK, so they cannot disagree at the database level.
model Transaction {
  id                String   @id @db.Uuid
  seq               BigInt   @unique @default(autoincrement())
  userId            String   @map("user_id") @db.Uuid
  checkoutSessionId String   @map("checkout_session_id") @db.Uuid
  amountMinor       BigInt   @map("amount_minor")
  currency          String
  status            String
  scenario          String
  resolveAt         DateTime? @map("resolve_at") @db.Timestamptz(6)
  resolveTo         String?  @map("resolve_to")
  failureCode       String?  @map("failure_code")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(6)
  session           CheckoutSession @relation(fields: [checkoutSessionId, userId, amountMinor, currency], references: [id, userId, amountMinor, currency], onDelete: Cascade)

  @@map("transactions")
}

/// Append-only for UPDATE/TRUNCATE (trigger). DELETE is allowed so account deletion can cascade.
/// Ordering: seq (creation order). Uniqueness: one event per (user, subject, type).
model Event {
  id        String   @id @db.Uuid
  seq       BigInt   @unique @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  type      String
  subjectId String   @map("subject_id") @db.Uuid
  /// The exact serialized bytes (text, not jsonb), persisted once and returned verbatim.
  payload   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, subjectId, type])
  @@map("events")
}

model IdempotencyKey {
  userId      String   @map("user_id") @db.Uuid
  key         String
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  /// Response body WITHOUT the checkout token.
  response    Json
  /// Checkout token sealed with a purpose-derived key; AAD binds it to (user, key, session).
  tokenEnc    String   @map("token_enc")
  sessionId   String   @map("session_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, key])
  @@map("idempotency_keys")
}

model ApiRateLimit {
  userId      String   @map("user_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int

  @@id([userId, windowStart])
  @@map("api_rate_limits")
}

/// Not user-owned: pre-authentication abuse counters keyed by a hash of an ip or client id. No personal data.
model AuthFailureWindow {
  scope       String
  bucket      String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int

  @@id([scope, bucket, windowStart])
  @@map("auth_failure_windows")
}
